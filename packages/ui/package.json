    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next-themes": "catalog:",
    "radix-ui": "catalog:",
    "react-day-picker": "^10.0.2",
    "shadcn": "^4.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@lw/eslint-config": "workspace:*",
    "@lw/typescript-config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",

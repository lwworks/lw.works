# Neon Postgres (Vercel Marketplace or Neon dashboard)
DATABASE_URL=

# Better Auth
# Generate with: openssl rand -base64 32
# Also encrypts the stored Google OAuth tokens — rotating it requires every user to reconnect Google.
BETTER_AUTH_SECRET=
# Local: http://localhost:3001
# Production: https://os.lw.works
# Vercel Preview: leave unset (do NOT use "All Environments" for the production value) — derived from VERCEL_BRANCH_URL / VERCEL_URL; Google sign-in is proxied through
# https://os.lw.works (better-auth oAuthProxy), so previews need the same BETTER_AUTH_SECRET and Google client as production.
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth (Web application client)
# Authorized redirect URIs (previews reuse the production one):
#   http://localhost:3001/api/auth/callback/google
#   https://os.lw.works/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel AI Gateway (reads business cards on /kontakte/new)
# On Vercel, OIDC authenticates automatically. Locally: `vercel env pull` (VERCEL_OIDC_TOKEN) or an AI Gateway API key.
AI_GATEWAY_API_KEY=

# Vercel Cron (sent as "Authorization: Bearer <CRON_SECRET>" to /api/cron/calendar-sync)
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Neon Object Storage (S3-compatible; company logos, later contact photos and receipts). Private bucket `uploads`,
# declared in neon.ts. Locally, `neon deploy` / `neon env pull` write AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_ENDPOINT_URL_S3 and AWS_REGION into .env.local — the app reads those, nothing to rename.
# On Vercel, set the same values under these names instead (Vercel reserves AWS_*):
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Optional, defaults to `uploads`
OBJECT_STORAGE_BUCKET=
# Without any of these, logos are not stored and the icon route fetches favicons live instead.
